# Copy this file to .env and fill in real values.
# .env is gitignored so secrets never get committed.
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-string
# "mysql" is the docker compose service name; the app container reaches
# MariaDB through docker's network, not localhost.
MYSQL_HOST=mysql
MYSQL_USER=myportfolio
MYSQL_PASSWORD=replace-with-a-db-password
MYSQL_DATABASE=myportfoliodb
# Required by the mariadb image to initialize a fresh data volume.
MARIADB_ROOT_PASSWORD=replace-with-a-root-password
